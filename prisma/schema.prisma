generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// VIJAYA Booking Platform — data model
// Source of truth flow: Website/Booking UI <-> VIJAYA Booking Service <-> CRM
// ---------------------------------------------------------------------------

/// Bookable inventory mirror (synced/seeded from master data). Editable by ops/CRM.
model Space {
  id                 String   @id // slug
  crmVenueId         String?  // CRM linkage — populated when CRM is confirmed
  name               String
  category           String   // WEDDING | BUSINESS | CELEBRATION | MULTI
  setting            String   // INDOOR | OUTDOOR
  capacityMin        Int?
  capacityMax        Int?
  bookableOnline     Boolean  @default(true)
  requiresApproval   Boolean  @default(false)
  availabilityEnabled Boolean @default(true)
  active             Boolean  @default(true)
  sortOrder          Int @default(0)
  description        String?
  pricingJson        String?
  slotStates         SlotState[]
  bookings           Booking[]
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

/// PostgreSQL overlap guards live in 202611230004_native_live_cms/migration.sql.
/// One row per space/date/slot that is NOT available. Absence of a row = AVAILABLE.
/// Unique constraint on (spaceId,date,slot) gives atomic double-booking protection.
model SlotState {
  id            String    @id @default(cuid())
  spaceId       String
  date          String // YYYY-MM-DD
  slot          String // MORNING | AFTERNOON | EVENING | FULL_DAY
  status        SlotStatus
  source        String    @default("ONLINE") // ONLINE | OFFLINE_CRM | OPS
  holdExpiresAt DateTime? @db.Timestamptz(3)
  bookingRef    String?
  startMinute   Int?
  endMinute     Int?
  groupId       String?
  note          String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  space         Space     @relation(fields: [spaceId], references: [id])

  @@unique([spaceId, date, slot])
  @@index([date, slot])
  @@index([bookingRef])
}

/// Customer booking record.
model Booking {
  id             String    @id @default(cuid())
  reference      String    @unique // VIJ-XXXXXX
  spaceId        String // space slug or combo slug (e.g. nila-pamba)
  spaceName      String
  childSpaceIds  String? // JSON array — child spaces blocked for combos
  eventType      String // WEDDING | BUSINESS | CELEBRATION
  eventDate      String // YYYY-MM-DD
  slot           String
  guests         Int
  status         BookingStatus
  crmSync        String    @default("NOT_CONNECTED") // NOT_CONNECTED | SYNCED | QUEUED | FAILED
  customerName   String
  customerPhone  String
  customerEmail  String
  source         String @default("WEB")
  createdById    String?
  requestKey     String? @unique
  requestHash    String?
  startAt        DateTime? @db.Timestamptz(3)
  endAt          DateTime? @db.Timestamptz(3)
  customerCountry String   @default("India")
  notes          String?
  baseAmount     Decimal @db.Decimal(14, 2)
  weekendUplift  Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(14, 2)
  depositAmount  Decimal       @default(0) @db.Decimal(14, 2)
  totalPayable   Decimal @db.Decimal(14, 2)
  addons         Json?
  holdExpiresAt  DateTime? @db.Timestamptz(3)
  confirmedAt    DateTime? @db.Timestamptz(3)
  cancelledAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  space          Space     @relation(fields: [spaceId], references: [id])
  payments       Payment[]
  documents      Document[]
  milestones     Milestone[]

  @@index([customerEmail])
  @@index([eventDate])
}

/// Payment transactions — idempotent, gateway-ready.
model Payment {
  id             String   @id @default(cuid())
  bookingId      String
  provider       String   @default("SANDBOX") // SANDBOX until gateway is confirmed
  providerRef    String   @unique
  idempotencyKey String   @unique
  amount         Decimal @db.Decimal(14, 2)
  status         PaymentStatus
  method         String?
  transactionId  String?
  failureReason  String?
  paidAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  booking        Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

/// Leads from Plan Your Event, Venue Visit, Contact, Global Desk and concierge handoffs.
model Lead {
  id            String   @id @default(cuid())
  type          String // PLAN_EVENT | VENUE_VISIT | CONTACT | GLOBAL_DESK | CONCIERGE
  stage         String   @default("New Lead") // CRM pipeline stage
  name          String
  phone         String
  email         String
  country       String?
  eventType     String?
  eventDate     String?
  slot          String?
  guests        Int?
  venueInterest String?
  setting       String? // INDOOR | OUTDOOR | EITHER
  visitDate     String?
  visitTime     String?
  message       String?
  source        String   @default("website")
  internalNotes String?
  followUpAt    DateTime? @db.Timestamptz(3)
  utmJson       String? // JSON string — utm_source etc.
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([type])
}

/// Post-booking documents (confirmation, invoice, receipt, agreement, uploads).
model Document {
  id        String   @id @default(cuid())
  bookingId String
  type      String // CONFIRMATION | INVOICE | RECEIPT | AGREEMENT | UPLOAD
  title     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  booking   Booking  @relation(fields: [bookingId], references: [id])
}

/// Event plan milestones shown in My VIJAYA.
model Milestone {
  id        String    @id @default(cuid())
  bookingId String
  title     String
  detail    String?
  dueDate   String?
  status    String    @default("UPCOMING") // UPCOMING | DONE
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  booking   Booking   @relation(fields: [bookingId], references: [id])
}

/// Support requests from the portal.
model SupportTicket {
  id        String   @id @default(cuid())
  bookingRef String?
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// Analytics events (fire-and-forget beacon).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String?
  sessionId String?
  metaJson  String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([name])
}

/// Audit log for booking updates (security requirement).
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityRef String
  actorId   String?
  ip        String?
  beforeJson String?
  afterJson  String?
  detailJson String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model AdminUser {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  role               String
  disabled           Boolean  @default(false)
  mustChangePassword Boolean  @default(true)
  sessionVersion     Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

model LoginAttempt {
  key         String   @id
  failures    Int      @default(0)
  resetAt     DateTime @db.Timestamptz(3)
}

model ContentEntry {
  id           String   @id @default(cuid())
  key          String
  locale       String
  draft        Json
  published    Json?
  editedBy     String
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  versions     ContentVersion[]
  @@unique([key, locale])
}

model ContentVersion {
  id         String   @id @default(cuid())
  entryId    String
  payload    Json
  actorId    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  entry      ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@index([entryId, createdAt])
}

model MediaAsset {
  storageBucket String?
  version String?
  id        String   @id @default(cuid())
  filename  String
  mime      String
  size      Int
  alt       String
  folder    String
  tags      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model CustomerNote {
  id        String   @id @default(cuid())
  email     String
  note      String
  actorId   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([email])
}

model BookingNote {
  id         String   @id @default(cuid())
  bookingRef String
  note       String
  actorId    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  @@index([bookingRef])
}

model EmailLog {
  id          String   @id @default(cuid())
  bookingRef  String
  template    String
  status      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

model SessionConfig {
  id          String  @id @default(cuid())
  spaceId     String
  key         String
  label       String
  startMinute Int
  endMinute   Int
  enabled     Boolean @default(true)
  @@unique([spaceId, key])
}

model AdminSession {
  id         String   @id
  adminId    String
  lastSeenAt DateTime @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  @@index([adminId])
}

model PaymentSettings {
  id           String   @id
  mode         String   @default("OFFLINE")
  provider     String   @default("SIMULATOR")
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model GatewayCredential {
  provider       String   @id
  keyId          String
  encrypted      String
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}


enum BookingStatus {
  PENDING_HOLD
  PENDING_APPROVAL
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REJECTED
  EXPIRED
  COMPLETED
  NO_SHOW
}

enum SlotStatus {
  TEMPORARY_HOLD
  PENDING_APPROVAL
  PENDING_PAYMENT
  CONFIRMED
  BLOCKED
  MAINTENANCE
  INTERNAL_USE
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}
