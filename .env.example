# Supabase Connect dialog: transaction pooler :6543 for requests, session pooler :5432 for migrations.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?schema=vijaya&sslmode=require&pgbouncer=true&connection_limit=2
DIRECT_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?schema=vijaya&sslmode=require
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
SEED_ADMIN_EMAIL=admin@vicc.in
SEED_ADMIN_PASSWORD=
ADMIN_SESSION_MAX_AGE_MINUTES=480
BOOKING_HOLD_MINUTES=15
CRON_SECRET=
CRM_SYNC_KEY=
# On Vercel, use x-vercel-forwarded-for.
TRUSTED_CLIENT_IP_HEADER=
# Also select Sandbox in the admin panel on the test deployment.
ENABLE_SANDBOX_PAYMENTS=false
PAYMENT_CONFIG_ENCRYPTION_KEY=
SEED_DEMO_DATA=false
SUPABASE_URL=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=
# Standalone local fallback when Supabase Storage is absent.
UPLOADS_DIR=./uploads
SMTP_URL=
SMTP_FROM=
